{
	"schemaVersion": 1,
	"id": "smartshots",
	"version": "${version}",
	"name": "Smart Screenshots",
	"description": "Screenshots sorted by server and world, automatic shots, advancement and first-meeting shots, an in-game gallery with scene-aware search, highlights and an editor.",
	"authors": ["vadyanik"],
	"license": "Unlicense",
	"contact": {
		"homepage": "https://github.com/Vadyanik/smart-screenshots",
		"sources": "https://github.com/Vadyanik/smart-screenshots",
		"issues": "https://github.com/Vadyanik/smart-screenshots/issues"
	},
	"icon": "assets/smartshots/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.vadyanik.smartshots.SmartShots"]
	},
	"mixins": ["smartshots.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
